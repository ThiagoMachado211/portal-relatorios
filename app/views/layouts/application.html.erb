<!DOCTYPE html>
<html>
  <head>
    <title>Portal de Relatórios</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <header class="portal-topbar">

        <div class="portal-topbar__left">
          <%= link_to "Dashboard", "/dashboard", class: "topbar-link" %>

          <div class="topbar-dropdown">
            <button type="button" class="topbar-link topbar-button">
              Operações
            </button>

            <div class="topbar-dropdown-menu">
              <%= link_to "Atendimento ao Cliente",
                  "/relatorios/setor-operacoes/atendimento-ao-cliente",
                  class: "topbar-dropdown-link" %>

              <%= link_to "Comunicação",
                  "/relatorios/setor-operacoes/comunicacao",
                  class: "topbar-dropdown-link" %>

              <%= link_to "Logística",
                  "/relatorios/setor-operacoes/logistica",
                  class: "topbar-dropdown-link" %>
            </div>
          </div>

          <div class="topbar-dropdown">
            <button type="button" class="topbar-link topbar-button">
              Pedagógico
            </button>
          </div>

          <div class="topbar-dropdown">
            <button type="button" class="topbar-link topbar-button">
              Calendários
            </button>
          </div>
        </div>

        <div class="portal-topbar__right">

          <div class="topbar-user">
            <div class="topbar-user__avatar">
              U
            </div>

            <div class="topbar-user__info">
              <strong>
                <%= current_user.email %>
              </strong>

              <span>Usuário</span>
            </div>
          </div>

          <%= button_to "Sair",
              destroy_user_session_path,
              method: :delete,
              class: "topbar-logout" %>

        </div>

      </header>
    <% end %>

    <main class="portal-main">
      <div class="portal-content">
        <%= yield %>
      </div>
    </main>
  </body>
</html>