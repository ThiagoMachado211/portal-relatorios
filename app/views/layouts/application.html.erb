<!DOCTYPE html>
<html>
  <head>
    <title>Estudo Play - Relatórios</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <header class="portal-topbar">

        <div class="portal-topbar__left">

          <!-- DASHBOARD -->
          <%= link_to "Visão Geral",
              "/dashboard",
              class: "topbar-link" %>

          <!-- RELATÓRIOS -->
          <div class="topbar-dropdown">

            <button
              type="button"
              class="topbar-link topbar-button">
              Relatórios ▾
            </button>

            <div class="topbar-dropdown-menu">

              <!-- OPERAÇÕES -->
              <div class="topbar-submenu">

                <button
                  type="button"
                  class="topbar-dropdown-link topbar-submenu-button">
                  Operações
                  <span>›</span>
                </button>

                <div class="topbar-submenu-menu">

                  <%= link_to "Atendimento ao Cliente",
                      "/relatorios/setor-operacoes/atendimento-ao-cliente",
                      class: "topbar-dropdown-link" %>

                  <%= link_to "Comunicação",
                      "/relatorios/setor-operacoes/comunicacao",
                      class: "topbar-dropdown-link" %>

                  <%= link_to "Logística",
                      "/relatorios/setor-operacoes/logistica",
                      class: "topbar-dropdown-link" %>

                </div>
              </div>

              <!-- PEDAGÓGICO -->
              <div class="topbar-submenu">

                <button
                  type="button"
                  class="topbar-dropdown-link topbar-submenu-button">
                  Pedagógico
                  <span>›</span>
                </button>

                <div class="topbar-submenu-menu">

                  <!--
                    Aqui entraremos depois com as subseções
                    reais do Setor Pedagógico.
                  -->

                </div>
              </div>

            </div>
          </div>

          <!-- CALENDÁRIOS -->
          <div class="topbar-dropdown">

            <button
              type="button"
              class="topbar-link topbar-button">
              Calendários ▾
            </button>

            <div class="topbar-dropdown-menu">

              <!--
                Colocaremos aqui as rotas reais dos calendários
                depois de confirmar como elas estão hoje.
              -->

            </div>
          </div>

          <!-- ADMINISTRAÇÃO -->
          <% if current_user.admin? %>

            <div class="topbar-dropdown">

              <button
                type="button"
                class="topbar-link topbar-button">
                Administração ▾
              </button>

              <div class="topbar-dropdown-menu">

                <%= link_to "Usuários",
                    "/admin/users",
                    class: "topbar-dropdown-link" %>

                <%= link_to "Seções",
                    "/admin/sidebar_sections",
                    class: "topbar-dropdown-link" %>

                <%= link_to "Subseções",
                    "/admin/sidebar_subsections",
                    class: "topbar-dropdown-link" %>

                <%= link_to "Conteúdos",
                    "/admin/report_pages",
                    class: "topbar-dropdown-link" %>

              </div>
            </div>

          <% end %>

        </div>

        <div class="portal-topbar__right">

          <div class="topbar-user">

            <div class="topbar-user__avatar">
              <%= current_user.name.present? ?
                    current_user.name.first.upcase :
                    current_user.email.first.upcase %>
            </div>

            <div class="topbar-user__info">

              <strong>
                <%= current_user.name.presence || current_user.email %>
              </strong>

              <span>
                <%= current_user.user_type.to_s.humanize %>
              </span>

            </div>
          </div>

          <%= button_to "Sair",
              destroy_user_session_path,
              method: :delete,
              class: "topbar-logout" %>

        </div>

      </header>
    <% end %>

    <main class="portal-main">
      <div class="portal-content">
        <%= yield %>
      </div>
    </main>

  </body>
</html>