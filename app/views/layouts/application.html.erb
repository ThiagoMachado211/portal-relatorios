<!DOCTYPE html>
<html>
  <head>
    <title>Estudo Play - Relatórios</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <% if devise_controller? %>
      <%= stylesheet_link_tag "auth", "data-turbo-track": "reload" %>
    <% end %>

    <% if controller_name == "dashboard" %>
      <%= stylesheet_link_tag "dashboard", "data-turbo-track": "reload" %>
    <% end %>

    <% if controller_name == "report_pages" %>
      <%= stylesheet_link_tag "report_pages", "data-turbo-track": "reload" %>
      <%= stylesheet_link_tag "calendar", "data-turbo-track": "reload" %>
    <% end %>

    <% if controller_path.start_with?("admin/") %>
      <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
    <% end %>

    <% if controller_name == "long_trips" && action_name == "analytics" %>
      <%= stylesheet_link_tag "long_trips_analytics", "data-turbo-track": "reload" %>
    <% end %>

    <% if controller_name == "long_trips" && %w[new edit].include?(action_name) %>
      <%= stylesheet_link_tag "long_trips_form", "data-turbo-track": "reload" %>
    <% end %>

    <% if controller_name == "long_trips" && %w[dashboard presentation].include?(action_name) %>
      <%= stylesheet_link_tag "travel_dashboard", "data-turbo-track": "reload" %>
    <% end %>
<%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <header class="portal-topbar">

        <div class="portal-topbar__left">

          <!-- DASHBOARD -->
          <%= link_to "Visão Geral",
              "/dashboard",
              class: "topbar-link" %>

          <!-- RELATÓRIOS -->
          <div class="topbar-dropdown">

            <button
              type="button"
              class="topbar-link topbar-button">
              Relatórios ▾
            </button>

            <div class="topbar-dropdown-menu">

              <!-- OPERAÇÕES -->
              <div class="topbar-submenu">

                <button
                  type="button"
                  class="topbar-dropdown-link topbar-submenu-button">
                  Operações
                  <span>›</span>
                </button>

                <div class="topbar-submenu-menu">

                  <%= link_to "Atendimento ao Cliente",
                      "/relatorios/setor-operacoes/atendimento-ao-cliente",
                      class: "topbar-dropdown-link" %>

                  <%= link_to "Comunicação",
                      "/relatorios/setor-operacoes/comunicacao",
                      class: "topbar-dropdown-link" %>

                  <%= link_to "Logística",
                      "/relatorios/setor-operacoes/logistica",
                      class: "topbar-dropdown-link" %>

                </div>
              </div>

              <!-- PEDAGÓGICO -->
              <div class="topbar-submenu">

                <button
                  type="button"
                  class="topbar-dropdown-link topbar-submenu-button">
                  Pedagógico
                  <span>›</span>
                </button>

                <div class="topbar-submenu-menu">

                  <%= link_to "ENEM",
                      report_subsection_path(
                        section_slug: "setor-pedagogico",
                        subsection_slug: "enem"
                      ),
                      class: "topbar-dropdown-link" %>

                  <%= link_to "IDEB/SAEB",
                      report_subsection_path(
                        section_slug: "setor-pedagogico",
                        subsection_slug: "ideb-saeb"
                      ),
                      class: "topbar-dropdown-link" %>

                  <%= link_to "Avaliações Internas",
                      report_subsection_path(
                        section_slug: "setor-pedagogico",
                        subsection_slug: "avaliacoes-internas"
                      ),
                      class: "topbar-dropdown-link" %>

                </div>
              </div>

            </div>
          </div>

          
          <!-- ADMINISTRAÇÃO -->
          <% if current_user.admin? %>

            <div class="topbar-dropdown">

              <button
                type="button"
                class="topbar-link topbar-button">
                Administração ▾
              </button>

              <div class="topbar-dropdown-menu">

                <%= link_to "Usuários",
                    "/admin/users",
                    class: "topbar-dropdown-link" %>

                <%= link_to "Seções",
                    "/admin/sidebar_sections",
                    class: "topbar-dropdown-link" %>

                <%= link_to "Subseções",
                    "/admin/sidebar_subsections",
                    class: "topbar-dropdown-link" %>

                <%= link_to "Conteúdos",
                    "/admin/report_pages",
                    class: "topbar-dropdown-link" %>

              </div>
            </div>

          <% end %>

        </div>

        <div class="portal-topbar__right">

          <div class="topbar-user">

            <div class="topbar-user__avatar">
              <%= current_user.name.present? ?
                    current_user.name.first.upcase :
                    current_user.email.first.upcase %>
            </div>

            <div class="topbar-user__info">

              <strong>
                <%= current_user.name.presence || current_user.email %>
              </strong>

              <span>
                <%= current_user.user_type.to_s.humanize %>
              </span>

            </div>
          </div>

          <%= button_to "Sair",
              destroy_user_session_path,
              method: :delete,
              class: "topbar-logout" %>

        </div>

      </header>
    <% end %>

    <main class="portal-main">
      <div class="portal-content">
        <%= yield %>
      </div>
    </main>

  </body>
</html>