<%
  visible_report_pages =
    if current_user.admin?
      ReportPage.where(
        sidebar_section_id: @section.id,
        sidebar_subsection_id: @subsection.id
      ).order(:position, :title)
    else
      @report_pages
    end
%>

<div class="subsection-page">
  <% if @section.slug == "calendarios" && @subsection.slug == "mg" && @calendar_items.present? %>
    <%= render "calendar_mg" %>
  <% else %>
    <div class="subsection-card">
      <div class="card-title">
        <%= @subsection.title %>
      </div>

      <div class="card-subtitle">
        Conteúdos disponíveis nesta subseção
      </div>

      <% if current_user.admin? %>
        <div class="subsection-admin-toolbar">
          <div class="subsection-admin-toolbar__text">
            Como administrador, você pode cadastrar links do Power BI e gerenciar os relatórios desta subseção.
          </div>

          <%= link_to "Adicionar relatório Power BI",
              new_admin_report_page_path(
                sidebar_section_id: @section.id,
                sidebar_subsection_id: @subsection.id
              ),
              class: "btn-primary" %>
        </div>
      <% end %>

      <% if @section.slug == "setor-operacoes" && @subsection.slug == "logistica" %>
        <div class="report-item-card" style="margin-bottom: 18px;">
          <div class="report-item-header">
            <div class="report-item-title">
              Gestão de Trechos Longos
            </div>

            <div>
              <%= link_to "Abrir Analytics",
                  analytics_long_trips_path,
                  class: "btn-primary" %>
            </div>
          </div>

          <div class="report-item-description">
            Acesse o Analytics de Gestão de Viagens, com indicadores, filtros, detalhamento e apresentações.
          </div>
        </div>
      <% end %>

      <% if visible_report_pages.present? && visible_report_pages.any? %>
        <div class="profile-card">
          <% visible_report_pages.each do |page| %>
            <div class="report-item-card">
              <div class="report-item-header">
                <div class="report-item-title">
                  <%= page.title %>
                </div>

                <div>
                  <% if page.pdf? && page.embed_url.present? %>
                    <%= link_to "Abrir PDF",
                        page.embed_url,
                        target: "_blank",
                        rel: "noopener",
                        class: "btn-primary" %>

                  <% elsif page.pdf? && page.file.attached? %>
                    <%= link_to "Abrir PDF",
                        url_for(page.file),
                        target: "_blank",
                        rel: "noopener",
                        class: "btn-primary" %>

                  <% elsif page.external_link? && page.embed_url.present? %>
                    <%= link_to "Abrir Power BI",
                        page.embed_url,
                        target: "_blank",
                        rel: "noopener",
                        class: "btn-primary" %>

                  <% elsif page.streamlit? && page.embed_url.present? %>
                    <%= link_to "Abrir Dashboard",
                        page.embed_url,
                        target: "_blank",
                        rel: "noopener",
                        class: "btn-primary" %>

                  <% elsif page.file.attached? %>
                    <%= link_to "Abrir Arquivo",
                        url_for(page.file),
                        target: "_blank",
                        rel: "noopener",
                        class: "btn-primary" %>

                  <% else %>
                    <span class="btn-secondary" style="opacity:0.7; cursor:default;">
                      Indisponível
                    </span>
                  <% end %>

                  <% if current_user.admin? %>
                    <span class="report-item-admin-actions">
                      <% unless page.active? %>
                        <span class="report-item-admin-badge">INATIVO</span>
                      <% end %>

                      <%= link_to "Editar",
                          edit_admin_report_page_path(page),
                          class: "btn-secondary" %>
                    </span>
                  <% end %>
                </div>
              </div>

              <% if page.description.present? %>
                <div class="report-item-description">
                  <%= page.description %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>