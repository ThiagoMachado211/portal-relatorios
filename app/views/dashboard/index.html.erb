<div class="dashboard-home">

  <section class="dashboard-viewers-card">
    <div class="dashboard-home-title">
      Painéis Disponíveis
    </div>

    <div class="dashboard-home-subtitle">
      Acesse os painéis disponíveis para exibição.
    </div>

    <div class="viewer-grid">

      <div class="viewer-card">
        <div class="viewer-card__content">
          <div class="viewer-card__title">
            Gestão de Viagens
          </div>

          <div class="viewer-card__description">
            Painel de Trechos Longos com atualização em tempo real.
          </div>
        </div>

        <div class="viewer-card__actions">
          <%= link_to "Abrir Viewer",
              "/viewer.html",
              target: "_blank",
              rel: "noopener",
              class: "viewer-card__button" %>
        </div>
      </div>

    </div>
  </section>

</div>