<%
  overview = @dashboard_data[:overview]
  financial = @dashboard_data[:financial]
  period = @dashboard_data[:period]
%>

<div class="travel-analytics-page">

  <div class="travel-analytics-header">
    <div>
      <h1 class="travel-analytics-title">
        Gestão de Viagens
      </h1>

      <p class="travel-analytics-subtitle">
        Visão analítica dos trechos, viagens, conformidade e custos.
      </p>
    </div>

    <div class="travel-analytics-header-actions">

      <% if @can_manage_long_trips %>
        <%= link_to "Novo registro",
            new_long_trip_path,
            class: "btn-primary" %>
      <% end %>

      <%= link_to "Baixar dados filtrados",
          export_csv_long_trips_path(
            start_date: @start_date,
            end_date: @end_date,
            sector: @sector,
            transport_mode: @transport_mode,
            policy_compliant: @policy_compliant,
            canceled: @canceled
          ),
          class: "btn-secondary" %>

      <%= link_to "Apresentação sem financeiro",
          presentation_v2_long_trips_path(
             mode: "non_financial",
             start_date: @start_date,
             end_date: @end_date,
             sector: @sector,
             transport_mode: @transport_mode,
             policy_compliant: @policy_compliant,
             canceled: @canceled
           ),
          class: "btn-secondary",
          target: "_blank",
          rel: "noopener" %>

      <% if @can_view_financial %>
        <%= link_to "Apresentação completa",
            presentation_v2_long_trips_path(
               mode: "full",
               start_date: @start_date,
               end_date: @end_date,
               sector: @sector,
               transport_mode: @transport_mode,
               policy_compliant: @policy_compliant,
               canceled: @canceled
             ),
            class: "btn-primary",
            target: "_blank",
            rel: "noopener" %>
      <% end %>

    </div>
  </div>


  <!-- FILTROS -->
  <section class="travel-filter-card">

    <div class="travel-filter-card__header">
      <div>
        <h2>Filtros do dashboard</h2>
        <p>Todos os indicadores, gráficos e registros abaixo respeitam estes filtros.</p>
      </div>

      <% active_filters = [
           @start_date.present?,
           @end_date.present?,
           @sector.present?,
           @transport_mode.present?,
           @policy_compliant.present?,
           @canceled.present?
         ].count(true) %>

      <% if active_filters.positive? %>
        <span class="travel-filter-count"><%= active_filters %> ativos</span>
      <% end %>
    </div>

    <%= form_with url: analytics_long_trips_path,
                  method: :get,
                  local: true,
                  class: "travel-filter-form" do |form| %>

      <div class="travel-filter-group">
        <%= form.label :start_date, "Data inicial" %>
        <%= form.date_field :start_date, value: @start_date, class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :end_date, "Data final" %>
        <%= form.date_field :end_date, value: @end_date, class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :sector, "Setor" %>
        <%= form.select :sector,
              options_for_select([["Todos", ""]] + @available_sectors.map { |item| [item, item] }, @sector),
              {},
              class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :transport_mode, "Meio de transporte" %>
        <%= form.select :transport_mode,
              options_for_select([["Todos", ""]] + @available_transport_modes.map { |item| [item, item] }, @transport_mode),
              {},
              class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :policy_compliant, "Conformidade" %>
        <%= form.select :policy_compliant,
              options_for_select(
                [["Todos", ""], ["Conforme", "true"], ["Não conforme", "false"]],
                @policy_compliant
              ),
              {},
              class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :canceled, "Cancelamento" %>
        <%= form.select :canceled,
              options_for_select(
                [["Todos", ""], ["Cancelada", "true"], ["Não cancelada", "false"]],
                @canceled
              ),
              {},
              class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-actions">
        <%= form.submit "Aplicar filtros", class: "btn-primary" %>
        <%= link_to "Limpar", analytics_long_trips_path, class: "btn-secondary" %>
      </div>

    <% end %>

    <% if active_filters.positive? %>
      <div class="travel-active-filters">
        <span>Filtros ativos:</span>
        <% if @start_date.present? %><strong>Desde <%= @start_date.strftime("%d/%m/%Y") %></strong><% end %>
        <% if @end_date.present? %><strong>Até <%= @end_date.strftime("%d/%m/%Y") %></strong><% end %>
        <% if @sector.present? %><strong>Setor: <%= @sector %></strong><% end %>
        <% if @transport_mode.present? %><strong>Transporte: <%= @transport_mode %></strong><% end %>
        <% if @policy_compliant.present? %><strong>Conformidade: <%= @policy_compliant == "true" ? "Conforme" : "Não conforme" %></strong><% end %>
        <% if @canceled.present? %><strong>Cancelamento: <%= @canceled == "true" ? "Cancelada" : "Não cancelada" %></strong><% end %>
      </div>
    <% end %>

  </section>


  <!-- PERÍODO -->
  <div class="travel-period-info">

    <% if period[:start_date].present? && period[:end_date].present? %>

      Período analisado:

      <strong>
        <%= period[:start_date].strftime("%d/%m/%Y") %>
      </strong>

      até

      <strong>
        <%= period[:end_date].strftime("%d/%m/%Y") %>
      </strong>

    <% else %>

      Nenhum período disponível.

    <% end %>

  </div>


  <!-- KPIs OPERACIONAIS -->
  <section class="travel-kpi-section">

    <h2 class="travel-section-title">
      Indicadores Operacionais
    </h2>

    <div class="travel-kpi-grid">

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Total de Viagens
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(overview[:total_trips], delimiter: ".") %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Total de Trechos
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(overview[:total_segments], delimiter: ".") %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Trechos Aéreos
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(overview[:total_air_segments], delimiter: ".") %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Trechos Terrestres
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(overview[:total_land_segments], delimiter: ".") %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Quilometragem Total
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(
                overview[:total_mileage],
                delimiter: ".",
                separator: ","
              ) %>
          km
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Antecedência Média
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_precision(
                overview[:average_lead_time_days],
                precision: 2,
                separator: ","
              ) %>
          dias
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Cancelamentos
        </span>

        <strong class="travel-kpi-value">
          <%= overview[:canceled_segments] %>
        </strong>

        <span class="travel-kpi-meta">
          <%= number_with_precision(
                overview[:cancellation_rate],
                precision: 2,
                separator: ","
              ) %>%
        </span>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Conformidade
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_precision(
                overview[:compliance_rate],
                precision: 2,
                separator: ","
              ) %>%
        </strong>

        <span class="travel-kpi-meta">
          <%= overview[:compliant_segments] %>
          conformes
        </span>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Não conformes
        </span>

        <strong class="travel-kpi-value">
          <%= overview[:non_compliant_segments] %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Destino mais frequente
        </span>

        <strong class="travel-kpi-value travel-kpi-value--text">
          <%= overview[:most_frequent_destination].presence || "-" %>
        </strong>
      </div>

    </div>

  </section>


  <!-- KPIs FINANCEIROS -->
  <% if @can_view_financial && financial.present? %>

    <section class="travel-kpi-section">

      <h2 class="travel-section-title">
        Indicadores Financeiros
      </h2>

      <div class="travel-kpi-grid">

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Valor das Compras
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:purchase_value_brl],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Taxas Extras
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:extra_fees_brl],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Reembolsos
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:refund_value_brl],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Valor Final
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:final_value_brl],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Custo Médio por Trecho
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:average_final_value_brl_per_segment],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Custo Médio por Viagem
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:average_final_value_brl_per_trip],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Saldo em Pontos
          </span>

          <strong class="travel-kpi-value">
            <%= number_with_delimiter(
                  financial[:final_value_points],
                  delimiter: ".",
                  separator: ","
                ) %>
          </strong>
        </div>

      </div>

    </section>

  <% end %>


  <!-- GRÁFICOS ANALÍTICOS -->

  <%
    monthly = @dashboard_data[:monthly]
    distributions = @dashboard_data[:distributions]

    monthly_segments = monthly[:total_segments] || []
    monthly_mileage  = monthly[:total_mileage] || []

    sectors      = distributions[:sectors] || {}
    destinations = distributions[:destinations] || {}

    max_segments =
      monthly_segments.map { |item| item[:value].to_f }.max.to_f

    max_mileage =
      monthly_mileage.map { |item| item[:value].to_f }.max.to_f

    max_sector =
      sectors.values.map(&:to_f).max.to_f

    max_destination =
      destinations.values.map(&:to_f).max.to_f
  %>


  <!-- ====================================================== -->
  <!-- EVOLUÇÃO MENSAL                                       -->
  <!-- ====================================================== -->

  <section class="travel-analysis-section">

    <h2 class="travel-section-title">
      Evolução Mensal
    </h2>

    <div class="travel-chart-grid">

      <!-- TRECHOS POR MÊS -->

      <article class="travel-analysis-card">

        <div class="travel-analysis-card__header">
          <div>
            <h3>Trechos por Mês</h3>
            <p>Quantidade total de trechos realizados.</p>
          </div>
        </div>

        <% if monthly_segments.any? %>

          <div class="travel-column-chart">

            <% monthly_segments.each do |item| %>

              <%
                value = item[:value].to_f

                height =
                  if max_segments.positive?
                    (value / max_segments * 100)
                  else
                    0
                  end
              %>

              <div class="travel-column-chart__item">

                <div class="travel-column-chart__track">
                  <div
                    class="travel-column-chart__bar-wrap"
                    style="height: <%= height.round(2) %>%;">
                    <div class="travel-column-chart__value">
                      <%= number_with_delimiter(
                        value.to_i,
                        delimiter: "."
                      ) %>
                    </div>
                    <div class="travel-column-chart__bar"></div>
                  </div>
                </div>

                <div class="travel-column-chart__label">
                  <%= item[:label].to_s.sub(" 2026", "") %>
                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="travel-analysis-empty">
            Nenhum dado disponível.
          </div>

        <% end %>

      </article>


      <!-- QUILOMETRAGEM POR MÊS -->

      <article class="travel-analysis-card">

        <div class="travel-analysis-card__header">
          <div>
            <h3>Quilometragem por Mês</h3>
            <p>Quilometragem total registrada mensalmente.</p>
          </div>
        </div>

        <% if monthly_mileage.any? %>

          <div class="travel-column-chart">

            <% monthly_mileage.each do |item| %>

              <%
                value = item[:value].to_f

                height =
                  if max_mileage.positive?
                    (value / max_mileage * 100)
                  else
                    0
                  end
              %>

              <div class="travel-column-chart__item">

                <div class="travel-column-chart__track">
                  <div
                    class="travel-column-chart__bar-wrap"
                    style="height: <%= height.round(2) %>%;">
                    <div class="travel-column-chart__value">
                      <%= number_with_delimiter(
                        value.round,
                        delimiter: "."
                      ) %>
                    </div>
                    <div class="travel-column-chart__bar"></div>
                  </div>
                </div>

                <div class="travel-column-chart__label">
                  <%= item[:label].to_s.sub(" 2026", "") %>
                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="travel-analysis-empty">
            Nenhum dado disponível.
          </div>

        <% end %>

      </article>

    </div>

  </section>


  <!-- ====================================================== -->
  <!-- DISTRIBUIÇÕES                                         -->
  <!-- ====================================================== -->

  <section class="travel-analysis-section">

    <h2 class="travel-section-title">
      Distribuições
    </h2>

    <div class="travel-chart-grid">

      <!-- SETORES -->

      <article class="travel-analysis-card">

        <div class="travel-analysis-card__header">
          <div>
            <h3>Trechos por Setor</h3>
            <p>Distribuição dos registros por setor do viajante.</p>
          </div>
        </div>

        <% if sectors.any? %>

          <div class="travel-horizontal-chart">

            <% sectors.each do |sector, value| %>

              <%
                percentage =
                  if max_sector.positive?
                    value.to_f / max_sector * 100
                  else
                    0
                  end
              %>

              <div class="travel-horizontal-chart__item">

                <div class="travel-horizontal-chart__top">
                  <span class="travel-horizontal-chart__label">
                    <%= sector %>
                  </span>

                  <strong class="travel-horizontal-chart__value">
                    <%= number_with_delimiter(
                          value,
                          delimiter: "."
                        ) %>
                  </strong>
                </div>

                <div class="travel-horizontal-chart__track">

                  <div
                    class="travel-horizontal-chart__bar"
                    style="width: <%= percentage.round(2) %>%;">
                  </div>

                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="travel-analysis-empty">
            Nenhum dado disponível.
          </div>

        <% end %>

      </article>


      <!-- DESTINOS -->

      <article class="travel-analysis-card">

        <div class="travel-analysis-card__header">
          <div>
            <h3>Principais Destinos</h3>
            <p>
              Cidades de destino mais frequentes, desconsiderando João Pessoa.
            </p>
          </div>
        </div>

        <% if destinations.any? %>

          <div class="travel-horizontal-chart">

            <% destinations.first(10).each do |city, value| %>

              <%
                percentage =
                  if max_destination.positive?
                    value.to_f / max_destination * 100
                  else
                    0
                  end
              %>

              <div class="travel-horizontal-chart__item">

                <div class="travel-horizontal-chart__top">

                  <span class="travel-horizontal-chart__label">
                    <%= city %>
                  </span>

                  <strong class="travel-horizontal-chart__value">
                    <%= number_with_delimiter(
                          value,
                          delimiter: "."
                        ) %>
                  </strong>

                </div>

                <div class="travel-horizontal-chart__track">

                  <div
                    class="travel-horizontal-chart__bar"
                    style="width: <%= percentage.round(2) %>%;">
                  </div>

                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="travel-analysis-empty">
            Nenhum dado disponível.
          </div>

        <% end %>

      </article>

    </div>

  </section>


  <% details = @dashboard_data[:details] || [] %>

  <section class="travel-analysis-section">

    <div class="travel-table-header">
      <div>
        <h2 class="travel-section-title">
          Detalhamento dos Trechos
        </h2>

        <p class="travel-table-subtitle">
          Registros considerados no período e nos filtros selecionados.
        </p>
      </div>

      <div class="travel-table-summary">
      <div class="travel-table-actions">
        <%= link_to "Baixar este recorte (CSV)",
            export_csv_long_trips_path(
              start_date: @start_date,
              end_date: @end_date,
              sector: @sector,
              transport_mode: @transport_mode,
              policy_compliant: @policy_compliant,
              canceled: @canceled
            ),
            class: "btn-secondary" %>
      </div>
        <div class="travel-table-count">
          <strong>
          <%= number_with_delimiter(
                details.size,
                delimiter: "."
              ) %>
        </strong>

        <span>
          registros
          </span>
        </div>
      </div>
    </div>


    <div class="travel-table-card">

      <% if details.any? %>

        <div class="travel-table-scroll">

          <table class="travel-detail-table">

            <thead>
              <tr>
                <th>ID Viagem</th>
                <th>Viajante</th>
                <th>Setor</th>
                <th>Motivo</th>

                <th>Compra</th>
                <th>Viagem</th>
                <th>Antecedência</th>

                <th>Transporte</th>

                <th>Origem</th>
                <th>Destino</th>

                <th>Empresa</th>
                <th>Km</th>

                <th>Conformidade</th>
                <th>Motivo não conformidade</th>

                <th>Cancelada?</th>

                <% if @can_manage_long_trips %>
                  <th>Ações</th>
                <% end %>

                <% if @can_view_financial %>
                  <th>Compra (R$)</th>
                  <th>Compra (Pontos)</th>
                  <th>Taxas Extras</th>
                  <th>Reembolso (R$)</th>
                  <th>Reembolso (Pontos)</th>
                  <th>Valor Final (R$)</th>
                  <th>Valor Final (Pontos)</th>
                <% end %>
              </tr>
            </thead>


            <tbody>

              <% details.each do |trip| %>

                <tr>

                  <td>
                    <%= trip[:travel_request_id].presence || "-" %>
                  </td>


                  <td class="travel-detail-table__strong">
                    <%= trip[:traveler_name].presence || "-" %>
                  </td>


                  <td>
                    <%= trip[:traveler_sector].presence || "-" %>
                  </td>


                  <td class="travel-detail-table__wrap">
                    <%= trip[:travel_reason].presence || "-" %>
                  </td>


                  <td>
                    <% if trip[:purchase_date].present? %>
                      <%= trip[:purchase_date].strftime("%d/%m/%Y") %>
                    <% else %>
                      -
                    <% end %>
                  </td>


                  <td>
                    <% if trip[:travel_date].present? %>
                      <%= trip[:travel_date].strftime("%d/%m/%Y") %>
                    <% else %>
                      -
                    <% end %>
                  </td>


                  <td>
                    <% if trip[:lead_time_days].present? %>
                      <%= trip[:lead_time_days] %> dias
                    <% else %>
                      -
                    <% end %>
                  </td>


                  <td>
                    <%= trip[:transport_mode].presence || "-" %>
                  </td>


                  <td>
                    <%= [
                          trip[:origin_city],
                          trip[:origin_state]
                        ].compact_blank.join(" / ").presence || "-" %>
                  </td>


                  <td>
                    <%= [
                          trip[:destination_city],
                          trip[:destination_state]
                        ].compact_blank.join(" / ").presence || "-" %>
                  </td>


                  <td>
                    <%= trip[:transport_company].presence || "-" %>
                  </td>


                  <td>
                    <% if trip[:mileage].present? %>
                      <%= number_with_delimiter(
                            trip[:mileage],
                            delimiter: ".",
                            separator: ","
                          ) %>
                    <% else %>
                      -
                    <% end %>
                  </td>


                  <td>
                    <% if trip[:policy_compliant].nil? %>

                      <span class="travel-status-badge travel-status-badge--neutral">
                        Não informado
                      </span>

                    <% elsif trip[:policy_compliant] %>

                      <span class="travel-status-badge travel-status-badge--success">
                        Sim
                      </span>

                    <% else %>

                      <span class="travel-status-badge travel-status-badge--danger">
                        Não
                      </span>

                    <% end %>
                  </td>


                  <td class="travel-detail-table__wrap">
                    <%= trip[:non_compliance_reason].presence || "-" %>
                  </td>


                  <td>
                    <% if trip[:canceled].nil? %>

                      <span class="travel-status-badge travel-status-badge--neutral">
                        Não informado
                      </span>

                    <% elsif trip[:canceled] %>

                      <span class="travel-status-badge travel-status-badge--danger">
                        Sim
                      </span>

                    <% else %>

                      <span class="travel-status-badge travel-status-badge--success">
                        Não
                      </span>

                    <% end %>
                  </td>



                  <% if @can_manage_long_trips %>
                    <td class="travel-record-actions">
                      <%= link_to "Editar",
                          edit_long_trip_path(trip[:id]),
                          class: "travel-action-button travel-action-button--edit" %>

                      <%= button_to "Excluir",
                          long_trip_path(trip[:id]),
                          method: :delete,
                          form: {
                            class: "travel-delete-form",
                            data: {
                              turbo_confirm: "Excluir este registro de viagem? Esta operação não poderá ser desfeita."
                            }
                          },
                          class: "travel-action-button travel-action-button--delete" %>
                    </td>
                  <% end %>

                  <% if @can_view_financial %>

                    <td>
                      <%= number_to_currency(
                            trip[:purchase_value_brl] || 0,
                            unit: "R$ ",
                            separator: ",",
                            delimiter: "."
                          ) %>
                    </td>


                    <td>
                      <%= number_with_delimiter(
                            trip[:purchase_value_points] || 0,
                            delimiter: ".",
                            separator: ","
                          ) %>
                    </td>


                    <td>
                      <%= number_to_currency(
                            trip[:extra_fees_brl] || 0,
                            unit: "R$ ",
                            separator: ",",
                            delimiter: "."
                          ) %>
                    </td>


                    <td>
                      <%= number_to_currency(
                            trip[:refund_value_brl] || 0,
                            unit: "R$ ",
                            separator: ",",
                            delimiter: "."
                          ) %>
                    </td>


                    <td>
                      <%= number_with_delimiter(
                            trip[:refund_value_points] || 0,
                            delimiter: ".",
                            separator: ","
                          ) %>
                    </td>


                    <td>
                      <%= number_to_currency(
                            trip[:final_value_brl] || 0,
                            unit: "R$ ",
                            separator: ",",
                            delimiter: "."
                          ) %>
                    </td>


                    <td>
                      <%= number_with_delimiter(
                            trip[:final_value_points] || 0,
                            delimiter: ".",
                            separator: ","
                          ) %>
                    </td>

                  <% end %>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      <% else %>

        <div class="travel-analysis-empty">
          Nenhum trecho encontrado para o período selecionado.
        </div>

      <% end %>

    </div>

  </section>




</div>