<%
  overview = @dashboard_data[:overview]
  financial = @dashboard_data[:financial]
  period = @dashboard_data[:period]
%>

<div class="travel-analytics-page">

  <div class="travel-analytics-header">
    <div>
      <h1 class="travel-analytics-title">
        Gestão de Viagens
      </h1>

      <p class="travel-analytics-subtitle">
        Visão analítica dos trechos, viagens, conformidade e custos.
      </p>
    </div>

    <div class="travel-analytics-header-actions">

      <% if @can_manage_long_trips %>
        <%= link_to "Novo registro",
            new_long_trip_path,
            class: "btn-primary" %>
      <% end %>

      <%= link_to "Baixar dados filtrados",
          export_csv_long_trips_path(
            start_date: @start_date,
            end_date: @end_date,
            sector: @sector,
            transport_mode: @transport_mode,
            policy_compliant: @policy_compliant,
            canceled: @canceled
          ),
          class: "btn-secondary" %>

      <%= link_to "Apresentação sem financeiro",
          presentation_v2_long_trips_path(
             mode: "non_financial",
             start_date: @start_date,
             end_date: @end_date,
             sector: @sector,
             transport_mode: @transport_mode,
             policy_compliant: @policy_compliant,
             canceled: @canceled
           ),
          class: "btn-secondary",
          target: "_blank",
          rel: "noopener" %>

      <% if @can_view_financial %>
        <%= link_to "Apresentação completa",
            presentation_v2_long_trips_path(
               mode: "full",
               start_date: @start_date,
               end_date: @end_date,
               sector: @sector,
               transport_mode: @transport_mode,
               policy_compliant: @policy_compliant,
               canceled: @canceled
             ),
            class: "btn-primary",
            target: "_blank",
            rel: "noopener" %>
      <% end %>

    </div>
  </div>


  <!-- FILTROS -->
  <section class="travel-filter-card">

    <div class="travel-filter-card__header">
      <div>
        <h2>Filtros do dashboard</h2>
        <p>Todos os indicadores, gráficos e registros abaixo respeitam estes filtros.</p>
      </div>

      <% active_filters = [
           @start_date.present?,
           @end_date.present?,
           @sector.present?,
           @transport_mode.present?,
           @policy_compliant.present?,
           @canceled.present?
         ].count(true) %>

      <% if active_filters.positive? %>
        <span class="travel-filter-count"><%= active_filters %> ativos</span>
      <% end %>
    </div>

    <%= form_with url: analytics_long_trips_path,
                  method: :get,
                  local: true,
                  class: "travel-filter-form" do |form| %>

      <div class="travel-filter-group">
        <%= form.label :start_date, "Data inicial" %>
        <%= form.date_field :start_date, value: @start_date, class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :end_date, "Data final" %>
        <%= form.date_field :end_date, value: @end_date, class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :sector, "Setor" %>
        <%= form.select :sector,
              options_for_select([["Todos", ""]] + @available_sectors.map { |item| [item, item] }, @sector),
              {},
              class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :transport_mode, "Meio de transporte" %>
        <%= form.select :transport_mode,
              options_for_select([["Todos", ""]] + @available_transport_modes.map { |item| [item, item] }, @transport_mode),
              {},
              class: "travel-filter-input" %>
      </div>


      <div class="travel-filter-group travel-filter-group--indicator">
        <%= form.label :indicator_view, "Indicadores / gráficos" %>
        <%= select_tag :indicator_view,
              options_for_select(
                [
                  ["Todos", "all"],
                  ["Indicadores operacionais", "operational"],
                  ["Indicadores financeiros", "financial"],
                  ["Trechos por mês", "monthly_segments"],
                  ["Quilometragem por mês", "monthly_mileage"],
                  ["Trechos por setor", "sectors"],
                  ["Principais destinos", "destinations"],
                  ["Gastos mensais", "monthly_costs"]
                ],
                params[:indicator_view].presence || "all"
              ),
              class: "travel-filter-input",
              id: "travel-indicator-selector" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :policy_compliant, "Conformidade" %>
        <%= form.select :policy_compliant,
              options_for_select(
                [["Todos", ""], ["Conforme", "true"], ["Não conforme", "false"]],
                @policy_compliant
              ),
              {},
              class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-group">
        <%= form.label :canceled, "Cancelamento" %>
        <%= form.select :canceled,
              options_for_select(
                [["Todos", ""], ["Cancelada", "true"], ["Não cancelada", "false"]],
                @canceled
              ),
              {},
              class: "travel-filter-input" %>
      </div>

      <div class="travel-filter-actions">
        <%= form.submit "Aplicar filtros", class: "btn-primary" %>
        <%= link_to "Limpar", analytics_long_trips_path, class: "btn-secondary" %>
      </div>

    <% end %>

    <% if active_filters.positive? %>
      <div class="travel-active-filters">
        <span>Filtros ativos:</span>
        <% if @start_date.present? %><strong>Desde <%= @start_date.strftime("%d/%m/%Y") %></strong><% end %>
        <% if @end_date.present? %><strong>Até <%= @end_date.strftime("%d/%m/%Y") %></strong><% end %>
        <% if @sector.present? %><strong>Setor: <%= @sector %></strong><% end %>
        <% if @transport_mode.present? %><strong>Transporte: <%= @transport_mode %></strong><% end %>
        <% if @policy_compliant.present? %><strong>Conformidade: <%= @policy_compliant == "true" ? "Conforme" : "Não conforme" %></strong><% end %>
        <% if @canceled.present? %><strong>Cancelamento: <%= @canceled == "true" ? "Cancelada" : "Não cancelada" %></strong><% end %>
      </div>
    <% end %>

  </section>


  <!-- PERÍODO -->
  <div class="travel-period-info">

    <% if period[:start_date].present? && period[:end_date].present? %>

      Período analisado:

      <strong>
        <%= period[:start_date].strftime("%d/%m/%Y") %>
      </strong>

      até

      <strong>
        <%= period[:end_date].strftime("%d/%m/%Y") %>
      </strong>

    <% else %>

      Nenhum período disponível.

    <% end %>

  </div>


  <!-- KPIs OPERACIONAIS -->
  <section class="travel-kpi-section" data-indicator-group="operational">

    <h2 class="travel-section-title">
      Indicadores Operacionais
    </h2>

    <div class="travel-kpi-grid">

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Total de Viagens
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(overview[:total_trips], delimiter: ".") %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Total de Trechos
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(overview[:total_segments], delimiter: ".") %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Trechos Aéreos
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(overview[:total_air_segments], delimiter: ".") %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Trechos Terrestres
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(overview[:total_land_segments], delimiter: ".") %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Quilometragem Total
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_delimiter(
                overview[:total_mileage],
                delimiter: ".",
                separator: ","
              ) %>
          km
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Antecedência Média
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_precision(
                overview[:average_lead_time_days],
                precision: 2,
                separator: ","
              ) %>
          dias
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Cancelamentos
        </span>

        <strong class="travel-kpi-value">
          <%= overview[:canceled_segments] %>
        </strong>

        <span class="travel-kpi-meta">
          <%= number_with_precision(
                overview[:cancellation_rate],
                precision: 2,
                separator: ","
              ) %>%
        </span>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Conformidade
        </span>

        <strong class="travel-kpi-value">
          <%= number_with_precision(
                overview[:compliance_rate],
                precision: 2,
                separator: ","
              ) %>%
        </strong>

        <span class="travel-kpi-meta">
          <%= overview[:compliant_segments] %>
          conformes
        </span>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Não conformes
        </span>

        <strong class="travel-kpi-value">
          <%= overview[:non_compliant_segments] %>
        </strong>
      </div>

      <div class="travel-kpi-card">
        <span class="travel-kpi-label">
          Destino mais frequente
        </span>

        <strong class="travel-kpi-value travel-kpi-value--text">
          <%= overview[:most_frequent_destination].presence || "-" %>
        </strong>
      </div>

    </div>

  </section>


  <!-- KPIs FINANCEIROS -->
  <% if @can_view_financial && financial.present? %>

    <section class="travel-kpi-section" data-indicator-group="financial">

      <h2 class="travel-section-title">
        Indicadores Financeiros
      </h2>

      <div class="travel-kpi-grid">

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Valor das Compras
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:purchase_value_brl],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Taxas Extras
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:extra_fees_brl],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Reembolsos
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:refund_value_brl],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Valor Final
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:final_value_brl],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Custo Médio por Trecho
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:average_final_value_brl_per_segment],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Custo Médio por Viagem
          </span>

          <strong class="travel-kpi-value">
            <%= number_to_currency(
                  financial[:average_final_value_brl_per_trip],
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          </strong>
        </div>

        <div class="travel-kpi-card">
          <span class="travel-kpi-label">
            Saldo em Pontos
          </span>

          <strong class="travel-kpi-value">
            <%= number_with_delimiter(
                  financial[:final_value_points],
                  delimiter: ".",
                  separator: ","
                ) %>
          </strong>
        </div>

      </div>

    </section>

  <% end %>


  <!-- GRÁFICOS ANALÍTICOS -->

  <%
    monthly = @dashboard_data[:monthly]
    distributions = @dashboard_data[:distributions]

    monthly_segments = monthly[:total_segments] || []
    monthly_mileage  = monthly[:total_mileage] || []

    sectors      = distributions[:sectors] || {}
    destinations = distributions[:destinations] || {}

    max_segments =
      monthly_segments.map { |item| item[:value].to_f }.max.to_f

    max_mileage =
      monthly_mileage.map { |item| item[:value].to_f }.max.to_f

    max_sector =
      sectors.values.map(&:to_f).max.to_f

    max_destination =
      destinations.values.map(&:to_f).max.to_f
  %>


  <!-- ====================================================== -->
  <!-- EVOLUÇÃO MENSAL                                       -->
  <!-- ====================================================== -->

  <section class="travel-analysis-section" data-indicator-section="monthly">

    <h2 class="travel-section-title">
      Evolução Mensal
    </h2>

    <div class="travel-chart-grid">

      <!-- TRECHOS POR MÊS -->

      <article class="travel-analysis-card" data-indicator-group="monthly_segments">

        <div class="travel-analysis-card__header">
          <div>
            <h3>Trechos por Mês</h3>
            <p>Quantidade total de trechos realizados.</p>
          </div>
        </div>

        <% if monthly_segments.any? %>

          <div class="travel-column-chart">

            <% monthly_segments.each do |item| %>

              <%
                value = item[:value].to_f

                height =
                  if max_segments.positive?
                    (value / max_segments * 100)
                  else
                    0
                  end
              %>

              <div class="travel-column-chart__item">

                <div class="travel-column-chart__track">
                  <div
                    class="travel-column-chart__bar-wrap"
                    style="height: <%= height.round(2) %>%;">
                    <div class="travel-column-chart__value">
                      <%= number_with_delimiter(
                        value.to_i,
                        delimiter: "."
                      ) %>
                    </div>
                    <div class="travel-column-chart__bar"></div>
                  </div>
                </div>

                <div class="travel-column-chart__label">
                  <%= item[:label].to_s.sub(" 2026", "") %>
                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="travel-analysis-empty">
            Nenhum dado disponível.
          </div>

        <% end %>

      </article>


      <!-- QUILOMETRAGEM POR MÊS -->

      <article class="travel-analysis-card" data-indicator-group="monthly_mileage">

        <div class="travel-analysis-card__header">
          <div>
            <h3>Quilometragem por Mês</h3>
            <p>Quilometragem total registrada mensalmente.</p>
          </div>
        </div>

        <% if monthly_mileage.any? %>

          <div class="travel-column-chart">

            <% monthly_mileage.each do |item| %>

              <%
                value = item[:value].to_f

                height =
                  if max_mileage.positive?
                    (value / max_mileage * 100)
                  else
                    0
                  end
              %>

              <div class="travel-column-chart__item">

                <div class="travel-column-chart__track">
                  <div
                    class="travel-column-chart__bar-wrap"
                    style="height: <%= height.round(2) %>%;">
                    <div class="travel-column-chart__value">
                      <%= number_with_delimiter(
                        value.round,
                        delimiter: "."
                      ) %>
                    </div>
                    <div class="travel-column-chart__bar"></div>
                  </div>
                </div>

                <div class="travel-column-chart__label">
                  <%= item[:label].to_s.sub(" 2026", "") %>
                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="travel-analysis-empty">
            Nenhum dado disponível.
          </div>

        <% end %>

      </article>

    </div>

  </section>


  <!-- ====================================================== -->
  <!-- DISTRIBUIÇÕES                                         -->
  <!-- ====================================================== -->

  <section class="travel-analysis-section" data-indicator-section="distributions">

    <h2 class="travel-section-title">
      Distribuições
    </h2>

    <div class="travel-chart-grid">

      <!-- SETORES -->

      <article class="travel-analysis-card" data-indicator-group="sectors">

        <div class="travel-analysis-card__header">
          <div>
            <h3>Trechos por Setor</h3>
            <p>Distribuição dos registros por setor do viajante.</p>
          </div>
        </div>

        <% if sectors.any? %>

          <div class="travel-horizontal-chart">

            <% sectors.each do |sector, value| %>

              <%
                percentage =
                  if max_sector.positive?
                    value.to_f / max_sector * 100
                  else
                    0
                  end
              %>

              <div class="travel-horizontal-chart__item">

                <div class="travel-horizontal-chart__top">
                  <span class="travel-horizontal-chart__label">
                    <%= sector %>
                  </span>

                  <strong class="travel-horizontal-chart__value">
                    <%= number_with_delimiter(
                          value,
                          delimiter: "."
                        ) %>
                  </strong>
                </div>

                <div class="travel-horizontal-chart__track">

                  <div
                    class="travel-horizontal-chart__bar"
                    style="width: <%= percentage.round(2) %>%;">
                  </div>

                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="travel-analysis-empty">
            Nenhum dado disponível.
          </div>

        <% end %>

      </article>


      <!-- DESTINOS -->

      <article class="travel-analysis-card" data-indicator-group="destinations">

        <div class="travel-analysis-card__header">
          <div>
            <h3>Principais Destinos</h3>
            <p>
              Cidades de destino mais frequentes, desconsiderando João Pessoa.
            </p>
          </div>
        </div>

        <% if destinations.any? %>

          <div class="travel-horizontal-chart">

            <% destinations.first(10).each do |city, value| %>

              <%
                percentage =
                  if max_destination.positive?
                    value.to_f / max_destination * 100
                  else
                    0
                  end
              %>

              <div class="travel-horizontal-chart__item">

                <div class="travel-horizontal-chart__top">

                  <span class="travel-horizontal-chart__label">
                    <%= city %>
                  </span>

                  <strong class="travel-horizontal-chart__value">
                    <%= number_with_delimiter(
                          value,
                          delimiter: "."
                        ) %>
                  </strong>

                </div>

                <div class="travel-horizontal-chart__track">

                  <div
                    class="travel-horizontal-chart__bar"
                    style="width: <%= percentage.round(2) %>%;">
                  </div>

                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="travel-analysis-empty">
            Nenhum dado disponível.
          </div>

        <% end %>

      </article>

    </div>

  </section>



  <% if @can_view_financial && financial.present? %>
    <%
      monthly_costs = financial[:monthly_final_value_brl] || []
      max_monthly_cost = monthly_costs.map { |item| item[:value].to_f }.max.to_f
    %>

    <section class="travel-analysis-section" data-indicator-section="monthly_costs">
      <h2 class="travel-section-title">Gastos Mensais</h2>

      <div class="travel-chart-grid travel-chart-grid--single">
        <article class="travel-analysis-card" data-indicator-group="monthly_costs">
          <div class="travel-analysis-card__header">
            <div>
              <h3>Valor Final por Mês</h3>
              <p>Evolução mensal do valor final dos trechos no recorte selecionado.</p>
            </div>
          </div>

          <% if monthly_costs.any? %>
            <div class="travel-column-chart">
              <% monthly_costs.each do |item| %>
                <%
                  value = item[:value].to_f
                  height = max_monthly_cost.positive? ? (value / max_monthly_cost * 100) : 0
                %>

                <div class="travel-column-chart__item">
                  <div class="travel-column-chart__track">
                    <div class="travel-column-chart__bar-wrap"
                         style="height: <%= height.round(2) %>%;">
                      <div class="travel-column-chart__value">
                        <%= number_to_currency(
                              value,
                              unit: "R$ ",
                              separator: ",",
                              delimiter: "."
                            ) %>
                      </div>
                      <div class="travel-column-chart__bar"></div>
                    </div>
                  </div>

                  <div class="travel-column-chart__label">
                    <%= item[:label].to_s.sub(" 2026", "") %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="travel-analysis-empty">Nenhum dado financeiro disponível.</div>
          <% end %>
        </article>
      </div>
    </section>
  <% end %>

  <% details = @dashboard_data[:details] || [] %>

  <section class="travel-analysis-section">

    <div class="travel-table-header">
      <div>
        <h2 class="travel-section-title">
          Detalhamento dos Trechos
        </h2>

        <p class="travel-table-subtitle">
          Registros considerados no período e nos filtros selecionados.
        </p>
      </div>

      <div class="travel-table-summary">
        <div class="travel-table-page-size">
          <label for="travel-table-page-size">Linhas</label>
          <select id="travel-table-page-size" class="travel-table-select">
            <option value="10">10</option>
            <option value="25" selected>25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>

        <div class="travel-table-actions">
          <%= link_to "Baixar este recorte (CSV)",
              export_csv_long_trips_path(
                start_date: @start_date,
                end_date: @end_date,
                sector: @sector,
                transport_mode: @transport_mode,
                policy_compliant: @policy_compliant,
                canceled: @canceled
              ),
              class: "btn-secondary" %>
        </div>

        <div class="travel-table-count">
          <strong>
          <%= number_with_delimiter(
                details.size,
                delimiter: "."
              ) %>
        </strong>

        <span>
          registros
          </span>
        </div>
      </div>
    </div>


    <div class="travel-table-card">

      <% if details.any? %>

        <div class="travel-table-scroll">

          <table class="travel-detail-table">

            <thead>
              <tr>
                <th class="travel-sortable" tabindex="0" role="button">ID Viagem <span class="travel-sort-icon">↕</span></th>
                <th class="travel-sortable" tabindex="0" role="button">Viajante <span class="travel-sort-icon">↕</span></th>
                <th class="travel-sortable" tabindex="0" role="button">Setor <span class="travel-sort-icon">↕</span></th>
                <th class="travel-sortable" tabindex="0" role="button">Motivo <span class="travel-sort-icon">↕</span></th>

                <th class="travel-sortable" tabindex="0" role="button">Compra <span class="travel-sort-icon">↕</span></th>
                <th class="travel-sortable" tabindex="0" role="button">Viagem <span class="travel-sort-icon">↕</span></th>
                <th class="travel-sortable" tabindex="0" role="button">Antecedência <span class="travel-sort-icon">↕</span></th>

                <th class="travel-sortable" tabindex="0" role="button">Transporte <span class="travel-sort-icon">↕</span></th>

                <th class="travel-sortable" tabindex="0" role="button">Origem <span class="travel-sort-icon">↕</span></th>
                <th class="travel-sortable" tabindex="0" role="button">Destino <span class="travel-sort-icon">↕</span></th>

                <th class="travel-sortable" tabindex="0" role="button">Empresa <span class="travel-sort-icon">↕</span></th>
                <th class="travel-sortable" tabindex="0" role="button">Km <span class="travel-sort-icon">↕</span></th>

                <th class="travel-sortable" tabindex="0" role="button">Conformidade <span class="travel-sort-icon">↕</span></th>
                <th class="travel-sortable" tabindex="0" role="button">Motivo não conformidade <span class="travel-sort-icon">↕</span></th>

                <th class="travel-sortable" tabindex="0" role="button">Cancelada? <span class="travel-sort-icon">↕</span></th>

                <% if @can_manage_long_trips %>
                  <th>Ações</th>
                <% end %>

                <% if @can_view_financial %>
                  <th class="travel-sortable" tabindex="0" role="button">Compra (R$) <span class="travel-sort-icon">↕</span></th>
                  <th class="travel-sortable" tabindex="0" role="button">Compra (Pontos) <span class="travel-sort-icon">↕</span></th>
                  <th class="travel-sortable" tabindex="0" role="button">Taxas Extras <span class="travel-sort-icon">↕</span></th>
                  <th class="travel-sortable" tabindex="0" role="button">Reembolso (R$) <span class="travel-sort-icon">↕</span></th>
                  <th class="travel-sortable" tabindex="0" role="button">Reembolso (Pontos) <span class="travel-sort-icon">↕</span></th>
                  <th class="travel-sortable" tabindex="0" role="button">Valor Final (R$) <span class="travel-sort-icon">↕</span></th>
                  <th class="travel-sortable" tabindex="0" role="button">Valor Final (Pontos) <span class="travel-sort-icon">↕</span></th>
                <% end %>
              </tr>
            </thead>


            <tbody>

              <% details.each do |trip| %>

                <tr>

                  <td>
                    <%= trip[:travel_request_id].presence || "-" %>
                  </td>


                  <td class="travel-detail-table__strong">
                    <%= trip[:traveler_name].presence || "-" %>
                  </td>


                  <td>
                    <%= trip[:traveler_sector].presence || "-" %>
                  </td>


                  <td class="travel-detail-table__wrap">
                    <%= trip[:travel_reason].presence || "-" %>
                  </td>


                  <td>
                    <% if trip[:purchase_date].present? %>
                      <%= trip[:purchase_date].strftime("%d/%m/%Y") %>
                    <% else %>
                      -
                    <% end %>
                  </td>


                  <td>
                    <% if trip[:travel_date].present? %>
                      <%= trip[:travel_date].strftime("%d/%m/%Y") %>
                    <% else %>
                      -
                    <% end %>
                  </td>


                  <td>
                    <% if trip[:lead_time_days].present? %>
                      <%= trip[:lead_time_days] %> dias
                    <% else %>
                      -
                    <% end %>
                  </td>


                  <td>
                    <%= trip[:transport_mode].presence || "-" %>
                  </td>


                  <td>
                    <%= [
                          trip[:origin_city],
                          trip[:origin_state]
                        ].compact_blank.join(" / ").presence || "-" %>
                  </td>


                  <td>
                    <%= [
                          trip[:destination_city],
                          trip[:destination_state]
                        ].compact_blank.join(" / ").presence || "-" %>
                  </td>


                  <td>
                    <%= trip[:transport_company].presence || "-" %>
                  </td>


                  <td>
                    <% if trip[:mileage].present? %>
                      <%= number_with_delimiter(
                            trip[:mileage],
                            delimiter: ".",
                            separator: ","
                          ) %>
                    <% else %>
                      -
                    <% end %>
                  </td>


                  <td>
                    <% if trip[:policy_compliant].nil? %>

                      <span class="travel-status-badge travel-status-badge--neutral">
                        Não informado
                      </span>

                    <% elsif trip[:policy_compliant] %>

                      <span class="travel-status-badge travel-status-badge--success">
                        Sim
                      </span>

                    <% else %>

                      <span class="travel-status-badge travel-status-badge--danger">
                        Não
                      </span>

                    <% end %>
                  </td>


                  <td class="travel-detail-table__wrap">
                    <%= trip[:non_compliance_reason].presence || "-" %>
                  </td>


                  <td>
                    <% if trip[:canceled].nil? %>

                      <span class="travel-status-badge travel-status-badge--neutral">
                        Não informado
                      </span>

                    <% elsif trip[:canceled] %>

                      <span class="travel-status-badge travel-status-badge--danger">
                        Sim
                      </span>

                    <% else %>

                      <span class="travel-status-badge travel-status-badge--success">
                        Não
                      </span>

                    <% end %>
                  </td>



                  <% if @can_manage_long_trips %>
                    <td class="travel-record-actions">
                      <%= link_to "Editar",
                          edit_long_trip_path(trip[:id]),
                          class: "travel-action-button travel-action-button--edit" %>

                      <%= button_to "Excluir",
                          long_trip_path(trip[:id]),
                          method: :delete,
                          form: {
                            class: "travel-delete-form",
                            data: {
                              turbo_confirm: "Excluir este registro de viagem? Esta operação não poderá ser desfeita."
                            }
                          },
                          class: "travel-action-button travel-action-button--delete" %>
                    </td>
                  <% end %>

                  <% if @can_view_financial %>

                    <td>
                      <%= number_to_currency(
                            trip[:purchase_value_brl] || 0,
                            unit: "R$ ",
                            separator: ",",
                            delimiter: "."
                          ) %>
                    </td>


                    <td>
                      <%= number_with_delimiter(
                            trip[:purchase_value_points] || 0,
                            delimiter: ".",
                            separator: ","
                          ) %>
                    </td>


                    <td>
                      <%= number_to_currency(
                            trip[:extra_fees_brl] || 0,
                            unit: "R$ ",
                            separator: ",",
                            delimiter: "."
                          ) %>
                    </td>


                    <td>
                      <%= number_to_currency(
                            trip[:refund_value_brl] || 0,
                            unit: "R$ ",
                            separator: ",",
                            delimiter: "."
                          ) %>
                    </td>


                    <td>
                      <%= number_with_delimiter(
                            trip[:refund_value_points] || 0,
                            delimiter: ".",
                            separator: ","
                          ) %>
                    </td>


                    <td>
                      <%= number_to_currency(
                            trip[:final_value_brl] || 0,
                            unit: "R$ ",
                            separator: ",",
                            delimiter: "."
                          ) %>
                    </td>


                    <td>
                      <%= number_with_delimiter(
                            trip[:final_value_points] || 0,
                            delimiter: ".",
                            separator: ","
                          ) %>
                    </td>

                  <% end %>

                </tr>

              <% end %>

            </tbody>

          </table>

        
          
</div>

        <div class="travel-table-pagination" id="travel-table-pagination">
            <button type="button" class="travel-pagination-button" id="travel-page-prev">← Anterior</button>
            <span id="travel-page-info">Página 1 de 1</span>
            <button type="button" class="travel-pagination-button" id="travel-page-next">Próxima →</button>
          </div>

      <% else %>

        <div class="travel-analysis-empty">
          Nenhum trecho encontrado para o período selecionado.
        </div>

      <% end %>

    </div>

  </section>




</div>


<script>
  document.addEventListener("turbo:load", () => {
    // -------------------------------------------------------
    // Seletor de indicadores / gráficos
    // -------------------------------------------------------
    const indicatorSelector = document.getElementById("travel-indicator-selector");
    const indicatorGroups = Array.from(document.querySelectorAll("[data-indicator-group]"));
    const indicatorSections = Array.from(document.querySelectorAll("[data-indicator-section]"));

    const applyIndicatorFilter = () => {
      if (!indicatorSelector) return;

      const selected = indicatorSelector.value || "all";

      indicatorGroups.forEach((element) => {
        element.hidden = selected !== "all" && element.dataset.indicatorGroup !== selected;
      });

      indicatorSections.forEach((section) => {
        const visibleChildren = Array.from(section.querySelectorAll("[data-indicator-group]"))
          .some((child) => !child.hidden);

        section.hidden = selected !== "all" && !visibleChildren;
      });
    };

    if (indicatorSelector && indicatorSelector.dataset.bound !== "true") {
      indicatorSelector.dataset.bound = "true";
      indicatorSelector.addEventListener("change", applyIndicatorFilter);
      applyIndicatorFilter();
    }

    // -------------------------------------------------------
    // Tabela: limite por página + ordenação
    // -------------------------------------------------------
    const table = document.querySelector(".travel-detail-table");
    const pageSizeSelect = document.getElementById("travel-table-page-size");
    const prevButton = document.getElementById("travel-page-prev");
    const nextButton = document.getElementById("travel-page-next");
    const pageInfo = document.getElementById("travel-page-info");

    if (!table || !pageSizeSelect || table.dataset.enhanced === "true") return;

    table.dataset.enhanced = "true";

    const tbody = table.querySelector("tbody");
    const headers = Array.from(table.querySelectorAll("thead th"));
    let rows = Array.from(tbody.querySelectorAll("tr"));
    let currentPage = 1;
    let sortColumn = -1;
    let sortDirection = 1;

    const parseValue = (raw) => {
      const text = (raw || "").trim();
      if (!text || text === "-") return "";

      const dateMatch = text.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
      if (dateMatch) {
        return Number(`${dateMatch[3]}${dateMatch[2]}${dateMatch[1]}`);
      }

      const daysMatch = text.match(/^(-?\d+(?:[.,]\d+)?)\s*dias?$/i);
      if (daysMatch) return Number(daysMatch[1].replace(",", "."));

      const cleaned = text
        .replace(/^R\$\s*/i, "")
        .replace(/\s*km$/i, "")
        .replace(/\s*%$/i, "")
        .replace(/\./g, "")
        .replace(",", ".");

      if (/^-?\d+(?:\.\d+)?$/.test(cleaned)) return Number(cleaned);

      return text.toLocaleLowerCase("pt-BR");
    };

    const renderPage = () => {
      const pageSize = Number(pageSizeSelect.value);
      const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));

      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * pageSize;
      const end = start + pageSize;

      rows.forEach((row, index) => {
        row.hidden = index < start || index >= end;
      });

      if (pageInfo) pageInfo.textContent = `Página ${currentPage} de ${totalPages}`;
      if (prevButton) prevButton.disabled = currentPage <= 1;
      if (nextButton) nextButton.disabled = currentPage >= totalPages;
    };

    const sortRows = (columnIndex) => {
      const sameColumn = sortColumn === columnIndex;
      sortDirection = sameColumn ? sortDirection * -1 : 1;
      sortColumn = columnIndex;

      rows.sort((a, b) => {
        const av = parseValue(a.cells[columnIndex]?.innerText);
        const bv = parseValue(b.cells[columnIndex]?.innerText);

        if (typeof av === "number" && typeof bv === "number") {
          return (av - bv) * sortDirection;
        }

        return String(av).localeCompare(String(bv), "pt-BR", {
          numeric: true,
          sensitivity: "base"
        }) * sortDirection;
      });

      rows.forEach((row) => tbody.appendChild(row));

      headers.forEach((header, index) => {
        const icon = header.querySelector(".travel-sort-icon");
        if (!icon) return;
        icon.textContent = index === sortColumn
          ? (sortDirection === 1 ? "↑" : "↓")
          : "↕";
      });

      currentPage = 1;
      renderPage();
    };

    headers.forEach((header, index) => {
      if (!header.classList.contains("travel-sortable")) return;

      header.addEventListener("click", () => sortRows(index));
      header.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          sortRows(index);
        }
      });
    });

    pageSizeSelect.addEventListener("change", () => {
      currentPage = 1;
      renderPage();
    });

    prevButton?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage -= 1;
        renderPage();
      }
    });

    nextButton?.addEventListener("click", () => {
      const totalPages = Math.max(1, Math.ceil(rows.length / Number(pageSizeSelect.value)));
      if (currentPage < totalPages) {
        currentPage += 1;
        renderPage();
      }
    });

    renderPage();
  });
</script>

