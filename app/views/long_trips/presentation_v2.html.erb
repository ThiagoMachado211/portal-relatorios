<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Gestão de Viagens — Apresentação</title>
  <style>
    :root{--blue:#041194;--blue2:#2563eb;--ink:#0f172a;--muted:#64748b;--line:#dbe3ee;--bg:#f6f8fc;--good:#15803d;--bad:#b91c1c;--orange:#c2410c}
    *{box-sizing:border-box} html,body{margin:0;width:100%;height:100%;font-family:Arial,Helvetica,sans-serif;background:#020617;color:var(--ink);overflow:hidden} button{font:inherit}
    .deck{position:fixed;inset:0;background:#fff}.slide{position:absolute;inset:0;display:none;padding:74px 56px 52px;background:linear-gradient(180deg,#fff 0%,#f6f8fc 100%);overflow:auto}.slide.active{display:block}
    .slide::after{content:"";position:fixed;right:-80px;bottom:-90px;width:350px;height:350px;border-radius:50%;background:rgba(4,17,148,.035);pointer-events:none}
    .eyebrow{color:var(--blue2);font-size:12px;font-weight:900;letter-spacing:.13em;text-transform:uppercase} h1{margin:8px 0 7px;font-size:42px;line-height:1.04;color:var(--blue)} h2{margin:8px 0 18px;font-size:31px;color:var(--blue)} h3{margin:0 0 14px;color:var(--ink)}
    .subtitle{color:var(--muted);font-size:16px;margin-bottom:23px}.kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:13px}.kpi{background:#fff;border:1px solid var(--line);border-radius:16px;padding:17px;box-shadow:0 7px 20px rgba(15,23,42,.055)}.kpi span{display:block;color:var(--muted);font-size:12px;font-weight:800;margin-bottom:7px}.kpi strong{display:block;font-size:27px;color:var(--ink)}.kpi small{display:block;margin-top:5px;color:var(--muted)}
    .chart{display:flex;flex-direction:column;justify-content:space-evenly;gap:10px;width:100%;max-width:1500px;min-height:85vh;height:85vh;margin:0 auto}.bar-row{display:grid;grid-template-columns:180px 1fr 120px;align-items:center;gap:14px;flex:1;min-height:0}.bar-label{text-align:right;font-size:15px;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-track{height:clamp(34px,5.1vh,56px);background:#e2e8f0;border-radius:10px;overflow:hidden}.bar-fill{height:100%;min-width:2px;background:linear-gradient(90deg,var(--blue),var(--blue2));border-radius:10px}.bar-fill.orange{background:linear-gradient(90deg,#ea580c,#fb923c)}.bar-value{font-weight:900;font-size:15px;white-space:nowrap}
    .slide:has(.chart){padding:64px 42px 10px;overflow:hidden}.slide:has(.chart) h2{margin:6px 0 8px;font-size:30px}.slide:has(.chart) .eyebrow{margin-bottom:2px}
    .slide:has(.chart) .note{position:absolute;left:42px;right:42px;bottom:12px;margin:0;z-index:2;background:rgba(238,244,255,.96)}
    .slide:has(.chart):has(.note) .chart{height:calc(85vh - 48px);min-height:calc(85vh - 48px);padding-bottom:52px}
    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 7px 20px rgba(15,23,42,.05)}.note{margin-top:18px;padding:14px 16px;border-radius:12px;background:#eef4ff;color:#334155;font-size:13px;line-height:1.5}.big-number{font-size:52px;font-weight:900;color:var(--blue);line-height:1}.metric-line{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid #eef2f7}.metric-line:last-child{border-bottom:0}.metric-line strong{color:var(--blue)}
    .controls{position:fixed;left:20px;top:18px;z-index:20;display:flex;gap:7px;align-items:center}.controls button{border:1px solid #cbd5e1;background:#fff;color:#0f172a;border-radius:9px;padding:7px 11px;font-weight:800;cursor:pointer}.controls .primary{background:var(--blue);color:#fff;border-color:var(--blue)}.controls .danger{background:#fff1f2;color:#be123c}.counter{font-weight:900;color:#475569;margin:0 5px}.progress{position:fixed;left:0;bottom:0;height:5px;background:var(--blue2);z-index:30;transition:width .25s}.mode-badge{position:fixed;right:22px;top:20px;z-index:20;background:#eef2ff;color:var(--blue);border:1px solid #c7d2fe;border-radius:999px;padding:7px 11px;font-size:11px;font-weight:900}.help{position:fixed;right:22px;bottom:14px;color:#64748b;font-size:11px;z-index:20}
    @media(max-width:900px){.slide{padding:72px 24px 50px}.kpis{grid-template-columns:repeat(2,1fr)}.two-col{grid-template-columns:1fr}.bar-row{grid-template-columns:110px 1fr 85px}.controls button:nth-of-type(4),.controls button:nth-of-type(5){display:none}.slide:has(.chart){padding:64px 20px 12px;overflow:auto}.slide:has(.chart) .chart{height:calc(100vh - 125px);min-height:calc(100vh - 125px)}.slide:has(.chart):has(.note) .chart{height:calc(100vh - 165px);min-height:calc(100vh - 165px);padding-bottom:44px}.slide:has(.chart) .note{left:20px;right:20px;bottom:8px}}
  </style>
</head>
<body>
<%
  data = @dashboard_data || {}
  overview = data[:overview] || {}; monthly = data[:monthly] || {}; distributions = data[:distributions] || {}
  lead_time = data[:lead_time] || {}; cancellations = data[:cancellations] || {}; accommodations = data[:accommodations] || {}
  transfers = data[:transfers] || {}; journeys = data[:journeys] || {}; financial = data[:financial] || {}
  period = data[:period] || {}
  number = ->(v,p=0){ number_with_precision(v.to_f, precision:p, delimiter:".", separator:",") }
  money = ->(v){ number_to_currency(v.to_f, unit:"R$ ", separator:",", delimiter:".") }
  pct = ->(v){ "#{number.call(v,1)}%" }
  chart_rows = ->(items,limit=10){
    rows = items.is_a?(Hash) ? items.to_a.first(limit) : Array(items).first(limit)
    max = rows.map{|x| x.is_a?(Array) ? x[1].to_f : x[:value].to_f}.max.to_f
    [rows, max.positive? ? max : 1]
  }
  format_period = if period[:start_date].present? && period[:end_date].present?
    "#{period[:start_date].strftime('%d/%m/%Y')} a #{period[:end_date].strftime('%d/%m/%Y')}"
  else
    "Período filtrado"
  end
%>

<div class="controls"><button id="prevBtn">←</button><button id="nextBtn">→</button><button id="autoBtn" class="primary">Pausar automático</button><button id="fullscreenBtn">Tela cheia</button><button id="downloadBtn">Baixar HTML</button><span id="counter" class="counter"></span><button id="closeBtn" class="danger">Fechar</button></div>
<div class="deck">
  <section class="slide active"><div class="eyebrow">Gestão de Viagens</div><h1>Visão executiva</h1><div class="subtitle"><%= format_period %></div><div class="kpis">
    <div class="kpi"><span>Viagens</span><strong><%= overview[:total_trips].to_i %></strong></div><div class="kpi"><span>Trechos longos</span><strong><%= overview[:total_segments].to_i %></strong></div><div class="kpi"><span>Quilometragem</span><strong><%= number.call(overview[:total_mileage],1) %></strong><small>km</small></div><div class="kpi"><span>Antecedência média</span><strong><%= number.call(overview[:average_lead_time_days],1) %></strong><small>dias</small></div><div class="kpi"><span>Conformidade</span><strong><%= pct.call(overview[:compliance_rate]) %></strong></div>
    <div class="kpi"><span>Cancelamentos</span><strong><%= pct.call(overview[:cancellation_rate]) %></strong></div><div class="kpi"><span>Hospedagens</span><strong><%= accommodations[:total_records].to_i %></strong></div><div class="kpi"><span>Diárias</span><strong><%= accommodations[:total_nights].to_i %></strong></div><div class="kpi"><span>Translados</span><strong><%= transfers[:total_transfers].to_i %></strong></div><div class="kpi"><span>Destino mais frequente</span><strong style="font-size:19px"><%= overview[:most_frequent_destination].presence || "—" %></strong></div>
  </div></section>

  <section class="slide"><div class="eyebrow">Volume</div><h2>Trechos por mês</h2><% rows,max=chart_rows.call(monthly[:total_segments]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= i[:value].to_i %></div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Mobilidade</div><h2>Quilometragem por mês</h2><% rows,max=chart_rows.call(monthly[:total_mileage]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= number.call(i[:value],1) %> km</div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Antecedência</div><h2>Evolução da antecedência média de compra</h2><% rows,max=chart_rows.call(lead_time[:monthly_average]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= number.call(i[:value],1) %> dias</div></div><% end %></div><div class="note">Indicador calculado apenas para registros com datas de compra e viagem válidas.</div></section>

  <section class="slide"><div class="eyebrow">Antecedência</div><h2>Distribuição por faixa de antecedência</h2><% rows,max=chart_rows.call(lead_time[:distribution]||{}) %><div class="chart"><% rows.each do |label,value| %><div class="bar-row"><div class="bar-label"><%= label %></div><div class="bar-track"><div class="bar-fill" style="width:<%= value.to_f/max*100 %>%"></div></div><div class="bar-value"><%= value %></div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Perfil</div><h2>Distribuição por setor</h2><% rows,max=chart_rows.call(distributions[:sectors]||{}) %><div class="chart"><% rows.each do |label,value| %><div class="bar-row"><div class="bar-label"><%= label %></div><div class="bar-track"><div class="bar-fill" style="width:<%= value.to_f/max*100 %>%"></div></div><div class="bar-value"><%= value %></div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Destinos</div><h2>Cidades mais frequentes</h2><% rows,max=chart_rows.call(distributions[:destinations]||{}) %><div class="chart"><% rows.each do |label,value| %><div class="bar-row"><div class="bar-label"><%= label %></div><div class="bar-track"><div class="bar-fill" style="width:<%= value.to_f/max*100 %>%"></div></div><div class="bar-value"><%= value %></div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Política</div><h2>Conformidade</h2><div class="two-col"><div class="panel"><div class="big-number"><%= pct.call(overview[:compliance_rate]) %></div><div class="subtitle">taxa de conformidade dos trechos avaliados</div></div><div class="panel"><div class="metric-line"><span>Conformes</span><strong><%= overview[:compliant_segments].to_i %></strong></div><div class="metric-line"><span>Não conformes</span><strong><%= overview[:non_compliant_segments].to_i %></strong></div><div class="metric-line"><span>Total avaliado</span><strong><%= overview[:compliant_segments].to_i + overview[:non_compliant_segments].to_i %></strong></div></div></div></section>

  <section class="slide"><div class="eyebrow">Cancelamentos</div><h2>Evolução da taxa de cancelamento</h2><% rows,max=chart_rows.call(cancellations[:monthly_rate]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill orange" style="width:<%= i[:value].to_f/[max,1].max*100 %>%"></div></div><div class="bar-value"><%= pct.call(i[:value]) %></div></div><% end %></div><div class="note"><strong><%= cancellations[:total].to_i %></strong> trechos cancelados no período.</div></section>

  <section class="slide"><div class="eyebrow">Hospedagem</div><h2>Visão geral</h2><div class="kpis"><div class="kpi"><span>Registros de hospedagem</span><strong><%= accommodations[:total_records].to_i %></strong></div><div class="kpi"><span>Viagens com hospedagem</span><strong><%= accommodations[:total_trips].to_i %></strong></div><div class="kpi"><span>Total de diárias</span><strong><%= accommodations[:total_nights].to_i %></strong></div><div class="kpi"><span>Estadia média</span><strong><%= number.call(accommodations[:average_stay_days],1) %></strong><small>dias</small></div><div class="kpi"><span>Hotéis utilizados</span><strong><%= accommodations[:unique_hotels].to_i %></strong></div></div></section>

  <section class="slide"><div class="eyebrow">Hospedagem</div><h2>Hospedagens por mês</h2><% rows,max=chart_rows.call(accommodations[:monthly_stays]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= i[:value].to_i %></div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Hospedagem</div><h2>Hotéis mais utilizados</h2><% rows,max=chart_rows.call(accommodations[:top_hotels]||{},8) %><div class="chart"><% rows.each do |label,value| %><div class="bar-row"><div class="bar-label"><%= label %></div><div class="bar-track"><div class="bar-fill" style="width:<%= value.to_f/max*100 %>%"></div></div><div class="bar-value"><%= value %></div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Translados</div><h2>Trechos curtos</h2><div class="kpis"><div class="kpi"><span>Translados</span><strong><%= transfers[:total_transfers].to_i %></strong></div><div class="kpi"><span>Viagens com translado</span><strong><%= transfers[:total_trips].to_i %></strong></div><div class="kpi"><span>Km estimados</span><strong><%= number.call(transfers[:total_mileage],1) %></strong></div><div class="kpi"><span>Km médio por translado</span><strong><%= number.call(transfers[:average_mileage],1) %></strong></div></div><h2 style="font-size:22px;margin-top:24px">Evolução mensal</h2><% rows,max=chart_rows.call(transfers[:monthly_transfers]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= i[:value].to_i %></div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Translados</div><h2>Rotas de translado mais frequentes</h2><% rows,max=chart_rows.call(transfers[:top_routes]||{},8) %><div class="chart"><% rows.each do |label,value| %><div class="bar-row"><div class="bar-label"><%= label %></div><div class="bar-track"><div class="bar-fill" style="width:<%= value.to_f/max*100 %>%"></div></div><div class="bar-value"><%= value %></div></div><% end %></div></section>

  <section class="slide"><div class="eyebrow">Viagens</div><h2>Duração das viagens</h2><div class="two-col"><div class="panel"><div class="big-number"><%= number.call(journeys[:average_duration_days],1) %></div><div class="subtitle">dias de duração média</div></div><div class="panel"><div class="metric-line"><span>Viagens consolidadas</span><strong><%= journeys[:total].to_i %></strong></div><div class="metric-line"><span>Hospedagens registradas</span><strong><%= accommodations[:total_records].to_i %></strong></div><div class="metric-line"><span>Translados registrados</span><strong><%= transfers[:total_transfers].to_i %></strong></div></div></div></section>

  <% if @presentation_mode == "full" && financial.present? %>
    <section class="slide"><div class="eyebrow">Financeiro</div><h2>Visão financeira consolidada</h2><div class="kpis"><div class="kpi"><span>Custo total das viagens</span><strong style="font-size:22px"><%= money.call(financial[:journey_total_value_brl]) %></strong></div><div class="kpi"><span>Média por viagem</span><strong style="font-size:22px"><%= money.call(financial[:journey_average_value_brl]) %></strong></div><div class="kpi"><span>Trechos longos</span><strong style="font-size:22px"><%= money.call(financial[:long_segments_total_brl]) %></strong></div><div class="kpi"><span>Trechos curtos</span><strong style="font-size:22px"><%= money.call(financial[:short_segments_total_brl]) %></strong></div><div class="kpi"><span>Hospedagem</span><strong style="font-size:22px"><%= money.call(financial[:accommodation_total_brl]) %></strong></div><div class="kpi"><span>Pontos</span><strong><%= number.call(financial[:journey_total_value_points]) %></strong></div></div></section>

    <section class="slide"><div class="eyebrow">Financeiro</div><h2>Composição do custo total</h2><% rows,max=chart_rows.call(financial[:composition]||{}) %><div class="chart"><% rows.each do |label,value| %><div class="bar-row"><div class="bar-label"><%= label %></div><div class="bar-track"><div class="bar-fill" style="width:<%= value.to_f/max*100 %>%"></div></div><div class="bar-value"><%= money.call(value) %></div></div><% end %></div></section>

    <section class="slide"><div class="eyebrow">Financeiro</div><h2>Custo total por mês</h2><% rows,max=chart_rows.call(financial[:monthly_journey_total_brl]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= money.call(i[:value]) %></div></div><% end %></div></section>

    <section class="slide"><div class="eyebrow">Financeiro</div><h2>Trechos longos por mês</h2><% rows,max=chart_rows.call(financial[:monthly_long_segments_brl]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= money.call(i[:value]) %></div></div><% end %></div></section>

    <section class="slide"><div class="eyebrow">Financeiro</div><h2>Trechos curtos por mês</h2><% rows,max=chart_rows.call(financial[:monthly_short_segments_brl]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill orange" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= money.call(i[:value]) %></div></div><% end %></div></section>

    <section class="slide"><div class="eyebrow">Financeiro</div><h2>Hospedagem por mês</h2><% rows,max=chart_rows.call(financial[:monthly_accommodation_brl]||[]) %><div class="chart"><% rows.each do |i| %><div class="bar-row"><div class="bar-label"><%= i[:label] %></div><div class="bar-track"><div class="bar-fill" style="width:<%= i[:value].to_f/max*100 %>%"></div></div><div class="bar-value"><%= money.call(i[:value]) %></div></div><% end %></div><div class="note">Diária média ponderada no período: <strong><%= money.call(accommodations[:average_daily_rate_brl]) %></strong>.</div></section>

    <section class="slide"><div class="eyebrow">Financeiro</div><h2>Conformidade × custo por km</h2><div class="two-col"><div class="panel"><h3>Trechos conformes</h3><div class="big-number" style="font-size:42px"><%= money.call(financial[:compliant_cost_per_km]) %></div><div class="subtitle">por km conhecido</div></div><div class="panel"><h3>Trechos não conformes</h3><div class="big-number" style="font-size:42px;color:var(--bad)"><%= money.call(financial[:non_compliant_cost_per_km]) %></div><div class="subtitle">por km conhecido</div></div></div><div class="note">Cálculo: valor final dos trechos longos dividido pela quilometragem registrada, separado pelo status de conformidade.</div></section>

    <section class="slide"><div class="eyebrow">Financeiro</div><h2>Valores em pontos</h2><div class="kpis"><div class="kpi"><span>Total consolidado</span><strong><%= number.call(financial[:journey_total_value_points]) %></strong></div><div class="kpi"><span>Compras nos trechos</span><strong><%= number.call(financial[:purchase_value_points]) %></strong></div><div class="kpi"><span>Reembolsos</span><strong><%= number.call(financial[:refund_value_points]) %></strong></div><div class="kpi"><span>Saldo final dos trechos</span><strong><%= number.call(financial[:final_value_points]) %></strong></div></div></section>
  <% end %>

  <section class="slide"><div class="eyebrow">Síntese</div><h2>Fechamento executivo</h2><div class="two-col"><div class="panel"><h3>Operação</h3><div class="metric-line"><span>Viagens</span><strong><%= overview[:total_trips].to_i %></strong></div><div class="metric-line"><span>Trechos longos</span><strong><%= overview[:total_segments].to_i %></strong></div><div class="metric-line"><span>Hospedagens</span><strong><%= accommodations[:total_records].to_i %></strong></div><div class="metric-line"><span>Translados</span><strong><%= transfers[:total_transfers].to_i %></strong></div></div><div class="panel"><h3>Eficiência e política</h3><div class="metric-line"><span>Antecedência média</span><strong><%= number.call(overview[:average_lead_time_days],1) %> dias</strong></div><div class="metric-line"><span>Conformidade</span><strong><%= pct.call(overview[:compliance_rate]) %></strong></div><div class="metric-line"><span>Cancelamentos</span><strong><%= pct.call(overview[:cancellation_rate]) %></strong></div><% if @presentation_mode == "full" && financial.present? %><div class="metric-line"><span>Custo consolidado</span><strong><%= money.call(financial[:journey_total_value_brl]) %></strong></div><% end %></div></div></section>
</div>
<div id="progress" class="progress"></div><div class="mode-badge"><%= @presentation_mode == "full" ? "APRESENTAÇÃO COMPLETA" : "SEM DADOS FINANCEIROS" %></div><div class="help">← → navegar · Espaço pausar/retomar · F tela cheia</div>
<script>(()=>{const slides=[...document.querySelectorAll('.slide')],counter=document.getElementById('counter'),progress=document.getElementById('progress'),autoBtn=document.getElementById('autoBtn');let index=0,timer=null,auto=true;const interval=12000;function show(i){index=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.classList.toggle('active',n===index));counter.textContent=`${index+1} / ${slides.length}`;progress.style.width=`${((index+1)/slides.length)*100}%`}function pause(){clearInterval(timer);timer=null;auto=false;autoBtn.textContent='Retomar automático'}function start(){clearInterval(timer);auto=true;autoBtn.textContent='Pausar automático';timer=setInterval(()=>show(index+1),interval)}function next(manual=false){if(manual)pause();show(index+1)}function prev(){pause();show(index-1)}function full(){if(!document.fullscreenElement)document.documentElement.requestFullscreen?.();else document.exitFullscreen?.()}function download(){const clone=document.documentElement.cloneNode(true);clone.querySelectorAll('.slide').forEach((s,n)=>s.classList.toggle('active',n===0));const blob=new Blob(['<!DOCTYPE html>\n'+clone.outerHTML],{type:'text/html;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='gestao_viagens_apresentacao.html';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}document.getElementById('nextBtn').onclick=()=>next(true);document.getElementById('prevBtn').onclick=prev;autoBtn.onclick=()=>auto?pause():start();document.getElementById('fullscreenBtn').onclick=full;document.getElementById('downloadBtn').onclick=download;document.getElementById('closeBtn').onclick=()=>{if(history.length>1)history.back();else window.close()};document.addEventListener('keydown',e=>{if(e.key==='ArrowRight')next(true);if(e.key==='ArrowLeft')prev();if(e.key===' '){e.preventDefault();auto?pause():start()}if(e.key.toLowerCase()==='f')full()});show(0);start()})();</script>
</body></html>
