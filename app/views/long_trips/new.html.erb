<div class="trip-form-page">
  <div class="trip-form-shell">
    <div class="trip-form-header">
      <div>
        <h1>Novo Registro de Viagem</h1>
        <p>Adicione um registro individual. Alterações em massa continuam sendo tratadas pela base oficial.</p>
      </div>

      <div class="trip-form-header__actions">
        <%= link_to "Voltar ao Analytics", analytics_long_trips_path, class: "trip-btn trip-btn--secondary" %>
      </div>
    </div>

    <%= render "form", submit_label: "Salvar registro" %>
  </div>
</div>
